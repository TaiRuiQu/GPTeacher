{
  "name": "gpt-teacher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write src server tests *.ts *.json index.html",
    "format:check": "prettier --check src server tests *.ts *.json index.html",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts server/*.test.ts",
    "test:e2e": "playwright test",
    "start": "node --experimental-strip-types server/index.ts",
    "test:server": "node --experimental-strip-types --test server/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "saxes": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.23.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.7"
  }
}
